# Local development only. Copy to .env; do not reuse these values in production.
APP_ENV=development
DATABASE_URL=postgres://dingdong:local-dingdong-only@127.0.0.1:55439/dingdong
DJANGO_SECRET_KEY=local-development-only-change-before-deployment-1234567890
JWT_SIGNING_KEY=local-jwt-key-different-from-django-key-12345678901234567890
SMS_MODE=fixed_code
# Set SMS_MODE=aliyun_verify only with this project's separate RAM AccessKey,
# a matched system-provided signature/template from Phone Number Verification.
ALIYUN_VERIFY_ACCESS_KEY_ID=
ALIYUN_VERIFY_ACCESS_KEY_SECRET=
ALIYUN_VERIFY_SIGN_NAME=
ALIYUN_VERIFY_TEMPLATE_CODE=
ALIYUN_VERIFY_REGION=cn-shanghai
ALIYUN_VERIFY_ENDPOINT=dypnsapi.aliyuncs.com
INTEGRATION_DATA_SOURCE=database_fixture
CA_DISPLAY_DATA_SOURCE=synthetic_fixture
COOKIE_SECURE=False
