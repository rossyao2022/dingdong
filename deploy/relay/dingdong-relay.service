[Unit]
Description=DingDong reverse tunnel to Shanghai public gateway
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -NT -i %h/.ssh/dingdong-relay -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%h/.ssh/dingdong-relay-known-hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -R 127.0.0.1:18473:100.115.66.119:18080 root@110.42.225.196
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
