server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 2m;
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location / { try_files $uri $uri/ =404; }
    # Every Django-served prefix must be listed here; anything missing falls
    # through to the static try_files below and returns an nginx 404.
    # Keep this list in sync with backend/config/urls.py (see deploy/tests).
    location ~ ^/(api/|admin/|ops/|static/) {
        proxy_pass http://api:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 65s;
    }
}
