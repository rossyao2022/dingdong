#!/usr/bin/env bash
# 仓库提交门禁（Trellis 接线的一部分）。安装：git config core.hooksPath .githooks
# 本 hook 负责两项文件级检查：② 暂存区无凭据/私钥 ③ 暂存 .md 时文档审计无 errors
# ① commit message 任务 id 的检查在 .githooks/commit-msg（pre-commit 阶段读不到新消息）。
set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

fail=0
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# ② 暂存区不得含凭据或私钥（.env.example 例外）
bad="$(printf '%s\n' "$staged" |
  grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|(^|/)id_rsa|(^|/)id_ed25519' |
  grep -vE '(^|/)\.env\.example$' || true)"
if [ -n "$bad" ]; then
  echo "pre-commit 拒绝②：暂存区含凭据/私钥类文件：" >&2
  printf '  %s\n' "$bad" >&2
  fail=1
fi

# ③ 暂存 .md 时跑文档审计，errors 必须为空。
# scripts/audit_documents.py 会重写两个结果文件；本 hook 只当门禁，跑完把工作区恢复原样。
if printf '%s\n' "$staged" | grep -qE '\.md$'; then
  snap="$(git rev-parse --absolute-git-dir)/trellis-precommit-snapshot"
  rm -rf "$snap"
  mkdir -p "$snap"
  for f in "文档/文档校验结果.json" "设计/API/契约检查结果.json"; do
    if [ -f "$f" ]; then
      mkdir -p "$snap/$(dirname "$f")"
      cp -p "$f" "$snap/$f"
    fi
  done

  audit_out="$(python3 scripts/audit_documents.py 2>&1)" && audit_rc=0 || audit_rc=$?
  if [ "$audit_rc" -ne 0 ]; then
    echo "pre-commit 拒绝③：文档审计 errors 非空（scripts/audit_documents.py 退出码 ${audit_rc}）。" >&2
    printf '%s\n' "$audit_out" | tail -n 1 >&2
    fail=1
  fi

  for f in "文档/文档校验结果.json" "设计/API/契约检查结果.json"; do
    if [ -f "$snap/$f" ]; then
      cp -p "$snap/$f" "$f"
    else
      rm -f "$f"
    fi
  done
  rm -rf "$snap"
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit 门禁未通过，提交已中止。可临时绕过：git commit --no-verify" >&2
  exit 1
fi
exit 0